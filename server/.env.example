# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5174
JWT_SECRET=shamiit_crm_jwt_secret_2026

# Remote PostgreSQL Connection (Neon / Supabase / AWS RDS / Render)
# Required for centralized user authentication, registration, and Google OAuth JSONB token persistence.
# Example for Neon: postgresql://username:password@ep-sample-pool.us-east-2.aws.neon.tech/sales_crm?sslmode=require
# Example for Supabase: postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/sales_crm?sslmode=require

# Google OAuth2 Credentials (User-specific Google Drive sync)
# Get these from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
